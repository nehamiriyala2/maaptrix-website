# Copy to .env.local before running `npm run build`. The site is a static export,
# so these values are baked into the files in /out at build time: rebuild and
# re-upload after changing them. Never commit real values.
#
# Contact form email is not configured here: it is sent by public/api/contact.php
# (recipient and sender addresses are set at the top of that file).

# --- Google Analytics 4 (public; inlined into the browser bundle at build time) ---
# GA4 > Admin > Data streams > Web > Measurement ID. GA is not loaded when empty.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Google Search Console (HTML tag method; needed at build time) ---
# Only the token from content="..." in the meta tag Search Console gives you.
# Not needed if the site is verified with a DNS TXT record (recommended).
GOOGLE_SITE_VERIFICATION=
