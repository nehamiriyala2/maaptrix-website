# Copy to .env.local for local development, and set the same variables in the
# hosting provider's environment settings for production. Never commit real values.

# --- Contact form email (server-side only; read by src/lib/email.ts) ---
# Provider: Resend (https://resend.com). Create an API key with "Sending access".
EMAIL_API_KEY=
# Verified sender. Until maaptrix.com is verified in Resend, use
# "Maaptrix Website <onboarding@resend.dev>" — Resend then only delivers to the
# email address that owns the Resend account, so sign up with maaptrix@gmail.com.
EMAIL_FROM=
# Inbox that receives enquiries. Defaults to maaptrix@gmail.com when empty.
EMAIL_TO=maaptrix@gmail.com

# --- Google Analytics 4 (public; inlined into the browser bundle at build time) ---
# GA4 > Admin > Data streams > Web > Measurement ID. GA is not loaded when empty.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Google Search Console (HTML tag method; needed at build time) ---
# Only the token from content="..." in the meta tag Search Console gives you.
# Not needed if the site is verified with a DNS TXT record (recommended).
GOOGLE_SITE_VERIFICATION=
