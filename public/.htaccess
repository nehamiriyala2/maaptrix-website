# Maaptrix static site on Hostinger shared hosting. Upload to public_html
# together with the rest of the `out` folder (next build copies it there).

Options -Indexes -MultiViews
DirectoryIndex index.html index.php

# Custom 404 page generated by Next.js
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. One canonical address: https://maaptrix.com (HTTP -> HTTPS, www -> no www),
  #    done in a single redirect.
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # 2. Clean URLs: /about/index.html -> /about/
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^ /%1 [L,R=301]

  # 3. Pages are folders, so add the trailing slash: /about -> /about/
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.*[^/])$ /$1/ [L,R=301]
</IfModule>

# Social share images are PNG files without a file extension (/about/opengraph-image).
<FilesMatch "^opengraph-image$">
  ForceType image/png
</FilesMatch>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript text/javascript application/json image/svg+xml
</IfModule>

# Browser caching. CSS/JS under /_next/static have content hashes in their names,
# so they can be cached for a year; HTML is always re-checked so updates show at once.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 1 week"
  ExpiresByType image/jpeg "access plus 1 week"
  ExpiresByType image/x-icon "access plus 1 week"
</IfModule>
